{
  "name": "rag-eval-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Ask the FastAPI manual in the browser: BM25 retrieval and the extractive answerer ported to TypeScript and tested for parity with the Python pipeline, the measured benchmark as charts, and a 3D map of the corpus.",
